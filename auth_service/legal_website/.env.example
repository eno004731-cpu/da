JWT_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/legal_auth
SPRING_DATASOURCE_USERNAME=legal_user
SPRING_DATASOURCE_PASSWORD=legal_pass
SPRING_KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
APP_FRONTEND_BASE_URL=http://localhost:3000
APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://127.0.0.1:3000,http://localhost:3000
GOOGLE_CLIENT_ID=

# Scheduler удаления проверяет NEW/FAILED outbox-события раз в 5 секунд.
APP_DELETE_OUTBOX_FIXED_DELAY_MS=5000
# Зависшее PROCESSING-событие повторяется через 3 минуты.
APP_DELETE_PROCESSING_TIMEOUT_MS=180000

# Отдельные Kafka topic для команд разным владельцам данных.
APP_KAFKA_TOPIC_DELETE_USER_ORDERS=user.delete-orders.requested
APP_KAFKA_TOPIC_DELETE_USER_DOCUMENTS=user.delete-documents.requested

# Отдельный пул выполняет callback после завершения Kafka send.
APP_DELETE_CALLBACK_CORE_POOL_SIZE=2
APP_DELETE_CALLBACK_MAX_POOL_SIZE=4
APP_DELETE_CALLBACK_QUEUE_CAPACITY=100
