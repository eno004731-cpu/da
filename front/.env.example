# Этот файл нужен для standalone/frontend-only запуска через:
# cd front && python3 server.py
# В docker-compose режиме этот же front/.env читается внутри frontend container.

# Base URL для обычного site/orders API.
# Если отдельного backend заявок пока нет, можно оставить пустым.
API_BASE_URL=

# Base URL для auth-service.
# Для test-контура сюда пойдёт https://testapi.philosophyabiz.ru/api
# Для prod-контура сюда пойдёт https://api.philosophyabiz.ru/api
AUTH_API_BASE_URL=http://127.0.0.1:8081/api

# Google client ID для фронта.
GOOGLE_CLIENT_ID=
