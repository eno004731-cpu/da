# Добавьте эти значения в локальный .env перед запуском Docker Compose.

# Topic ответа order-service о результате проверки документа.
APP_KAFKA_TOPIC_DOCUMENT_VALIDATION_RESULT=document.validation-result

# Период чтения validation-result outbox в order-service.
APP_DOCUMENT_VALIDATION_OUTBOX_DELAY_MS=5000

# Период отправки document-service outbox в Kafka.
APP_DOCUMENT_OUTBOX_RELAY_DELAY_MS=5000

# Как часто document-service ищет зависшие проверки.
APP_DOCUMENT_VALIDATION_RETRY_SCAN_DELAY_MS=5000

# Через сколько секунд без ответа запросить проверку повторно.
APP_DOCUMENT_VALIDATION_RETRY_AFTER_SECONDS=30
